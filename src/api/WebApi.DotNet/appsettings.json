{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "DefaultModel": "qwen3:14b",
    "Timeout": "00:02:00"
  },
  "Embeddings": {
    "OllamaBaseUrl": "http://localhost:11434",
    "Model": "nomic-embed-text",
    "Timeout": "00:01:00"
  },
  "AI": {
    "Indexing": {
      "Enabled": true,
      "StartupTimeout": "00:05:00",
      "ProbeQuery": "freezer meal prep recipes",
      "ProbeTopK": 1
    },
    "Reranking": {
      "Timeout": "00:00:12"
    }
  },
  "ChromaVectorStore": {
    "BaseUrl": "http://localhost:8001",
    "Tenant": "default_tenant",
    "Database": "default_database",
    "CollectionName": "recipe_embeddings",
    "Timeout": "00:00:30"
  },
  "Assistant": {
    "SystemPrompt": "You are a helpful meal planning assistant.",
    "MaximumToolCallsPerRequest": 10,
    "MaximumConversationSize": 100,
    "MaximumExecutionTime": "00:02:00"
  },
  "ConversationStore": {
    "RedisConnectionString": "localhost:6379,abortConnect=false,connectTimeout=5000,syncTimeout=5000",
    "MaximumConversations": 1000,
    "MaximumMessagesPerConversation": 50,
    "AutomaticTrimming": true,
    "ExpirationTimeout": "01:00:00"
  },
  "Resilience": {
    "Ollama": {
      "Enabled": true,
      "RetryCount": 2,
      "RetryBaseDelayMilliseconds": 200,
      "TimeoutMilliseconds": 120000,
      "ExceptionsAllowedBeforeBreaking": 5,
      "CircuitBreakerDurationSeconds": 30
    },
    "ChromaDb": {
      "Enabled": true,
      "RetryCount": 2,
      "RetryBaseDelayMilliseconds": 200,
      "TimeoutMilliseconds": 30000,
      "ExceptionsAllowedBeforeBreaking": 5,
      "CircuitBreakerDurationSeconds": 30
    },
    "Redis": {
      "Enabled": true,
      "RetryCount": 1,
      "RetryBaseDelayMilliseconds": 150,
      "TimeoutMilliseconds": 5000,
      "ExceptionsAllowedBeforeBreaking": 3,
      "CircuitBreakerDurationSeconds": 15
    },
    "PythonToolExecution": {
      "Enabled": true,
      "RetryCount": 0,
      "RetryBaseDelayMilliseconds": 250,
      "TimeoutMilliseconds": 90000,
      "ExceptionsAllowedBeforeBreaking": 3,
      "CircuitBreakerDurationSeconds": 20
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5001"
      }
    }
  }
}